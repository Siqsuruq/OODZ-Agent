    [list plan --max-count 12 --oneline --no-color --no-headers] \
    1 "sqitch_plan limit must be an integer from 1 to 500" 2]

test sqitch-show-1.1 {Sqitch show restricts views and object identifiers} -body {
    set root [file normalize [file join \
        [::tcltest::temporaryDirectory] sqitch-show-[pid]]]
    file mkdir $root
    set fakeSqitch [file join $root sqitch]
    set channel [open $fakeSqitch w]
    puts $channel {#!/bin/sh}
    close $channel
    file attributes $fakeSqitch -permissions 0755

    set ::RunnerMock::calls {}
    set runner [::tProcessRunner new \
        $root tclsh9.0 2500 4096 ::RunnerMock::execute \
        [dict create sqitch $fakeSqitch]]
    set plugins [::tPluginRegistry new \
        $root [list [file join $projectDir plugins]] \
        "" 1000 65536 {} "" "" $runner]
    try {
        set defaultResult [$plugins invoke sqitch_show [::json::write object \
            object [::json::write string add_users]]]
        set scriptResult [$plugins invoke sqitch_show [::json::write object \
            object [::json::write string add_users@HEAD] \
            view [::json::write string deploy]]]
        set invalidResults {}
        foreach arguments [list \
            [::json::write object object [::json::write string --target]] \
            [::json::write object object [::json::write string add_users] \
                view [::json::write string config]]] {
            lappend invalidResults [catch {
                $plugins invoke sqitch_show $arguments
            } message] $message
        }
        list \
            $defaultResult \
            [lrange [lindex [lindex $::RunnerMock::calls 0] 0] 1 end] \
            $scriptResult \
            [lrange [lindex [lindex $::RunnerMock::calls 1] 0] 1 end] \
            $invalidResults [llength $::RunnerMock::calls]
    } finally {
        $plugins destroy
        $runner destroy
        file delete -force $root
    }
} -result [list \
    "sandboxed Tcl output" [list show change add_users] \
    "sandboxed Tcl output" [list show deploy add_users@HEAD] \
    [list \
        1 "sqitch_show object contains unsupported characters" \
        1 "sqitch_show view must be one of: change, tag, deploy, revert, verify"] \
    2]

test sqitch-revert-1.1 {Sqitch revert requires a destination and approval} -body {
    set root [file normalize [file join \
        [::tcltest::temporaryDirectory] sqitch-revert-[pid]]]
    file mkdir $root
    set fakeSqitch [file join $root sqitch]
    set channel [open $fakeSqitch w]
    puts $channel {#!/bin/sh}
    close $channel
    file attributes $fakeSqitch -permissions 0755

    set ::RunnerMock::calls {}
    set ::ApprovalMock::calls {}
    set runner [::tProcessRunner new \
        $root tclsh9.0 2500 4096 ::RunnerMock::execute \
        [dict create sqitch $fakeSqitch]]
    set plugins [::tPluginRegistry new \
        $root [list [file join $projectDir plugins]] \
        ::ApprovalMock::decide 1000 65536 {} "" "" $runner]
    set validArguments [::json::write object \
        to [::json::write string @v1.0]]
    try {
        set invalidCode [catch {
            $plugins invoke sqitch_revert [::json::write object \
                to [::json::write string --all]]
        } invalidMessage]
        set ::ApprovalMock::approved 0
        set deniedCode [catch {
            $plugins invoke sqitch_revert $validArguments
        } deniedMessage]
        set ::ApprovalMock::approved 1
        set result [$plugins invoke sqitch_revert $validArguments]
        list \
            $invalidCode $invalidMessage \
            $deniedCode $deniedMessage $result \
            [lrange [lindex [lindex $::RunnerMock::calls 0] 0] 1 end] \
            [llength $::RunnerMock::calls]
    } finally {
        $plugins destroy
        $runner destroy
        file delete -force $root
    }
} -result [list \
    1 "sqitch_revert destination contains unsupported characters" \
    1 "Plugin execution denied: sqitch_revert" \
    "sandboxed Tcl output" \
    [list revert --to-change @v1.0 -y] 1]

