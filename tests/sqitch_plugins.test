test sqitch-tag-1.1 {Sqitch tag names an explicit change and requires approval} -body {
    set root [file normalize [file join \
        [::tcltest::temporaryDirectory] sqitch-tag-[pid]]]
    file mkdir $root
    set fakeSqitch [file join $root sqitch]
    set channel [open $fakeSqitch w]
