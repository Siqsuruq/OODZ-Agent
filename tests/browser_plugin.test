#!/usr/bin/env tclsh

source [file join [file dirname [file normalize [info script]]] support.tcl]

test open-browser-1.1 {browser launch is approved and command arguments are fixed} -body {
    set root [file normalize [file join \
        [::tcltest::temporaryDirectory] open-browser-[pid]]]
    file mkdir $root
    set fakeOpener [file join $root xdg-open]
    set channel [open $fakeOpener w]
    puts $channel {#!/bin/sh}
    close $channel
    file attributes $fakeOpener -permissions 0755
    set ::RunnerMock::calls {}
    set runner [::tProcessRunner new \
        $root tclsh9.0 2500 4096 ::RunnerMock::execute \
        [dict create xdg-open $fakeOpener]]
    set plugins [::tPluginRegistry new \
        $root [list [file join $projectDir plugins]] \
        ::ApprovalMock::decide 1000 65536 {} "" "" $runner \
        false {} linux]
    set arguments [::json::write object url \
        [::json::write string \
            "https://code.cloudz.cv/oodz_agent/?page=docs#start"]]
    try {
        set ::ApprovalMock::approved 0
        set deniedCode [catch {
            $plugins invoke open_browser $arguments
        } deniedMessage]
        set ::ApprovalMock::approved 1
        set result [$plugins invoke open_browser $arguments]
        list \
            $deniedCode $deniedMessage $result \
            [file tail [lindex [lindex \
                [lindex $::RunnerMock::calls 0] 0] 0]] \
            [lrange [lindex [lindex $::RunnerMock::calls 0] 0] 1 end] \
            [llength $::RunnerMock::calls]
    } finally {
        $plugins destroy
        $runner destroy
        file delete -force $root
    }
} -result [list \
    1 "Plugin execution denied: open_browser" \
    "sandboxed Tcl output" xdg-open \
    [list "https://code.cloudz.cv/oodz_agent/?page=docs#start"] 1]

test open-browser-1.2 {browser URL validation rejects unsafe inputs} -body {
    set root [file normalize [file join \
        [::tcltest::temporaryDirectory] open-browser-invalid-[pid]]]
    file mkdir $root
    set runner [::tProcessRunner new \
        $root tclsh9.0 2500 4096 ::RunnerMock::execute]
    set plugins [::tPluginRegistry new \
        $root [list [file join $projectDir plugins]] \
        ::ApprovalMock::decide 1000 65536 {} "" "" $runner \
        false {} linux]
    set ::ApprovalMock::approved 1
    try {
        set results {}
        foreach url [list \
            file:///etc/passwd \
            {javascript:alert(1)} \
            https://user:secret@example.com/ \
            "https://example.com/bad\npath" \
            example.com] {
            lappend results [catch {
                $plugins invoke open_browser [::json::write object \
                    url [::json::write string $url]]
            }]
        }
        set results
    } finally {
        $plugins destroy
        $runner destroy
        file delete -force $root
    }
} -result {1 1 1 1 1}

test open-browser-1.3 {Windows uses rundll32 without a command shell} -body {
    set root [file normalize [file join \
        [::tcltest::temporaryDirectory] open-browser-windows-[pid]]]
    file mkdir $root
    set fakeOpener [file join $root rundll32.exe]
    set channel [open $fakeOpener w]
    puts $channel {#!/bin/sh}
    close $channel
    file attributes $fakeOpener -permissions 0755
    set previousPath $::env(PATH)
    set ::env(PATH) "$root$::tcl_platform(pathSeparator)$previousPath"
    set ::RunnerMock::calls {}
    set runner [::tProcessRunner new \
        $root tclsh9.0 2500 4096 ::RunnerMock::execute \
        [dict create rundll32.exe $fakeOpener]]
    set plugins ""
    try {
        set plugins [::tPluginRegistry new \
            $root [list [file join $projectDir plugins]] \
            ::ApprovalMock::decide 1000 65536 {} "" "" $runner \
            false {} windows]
        set ::ApprovalMock::approved 1
        set result [$plugins invoke open_browser \
            [::json::write object url \
                [::json::write string "https://example.com/windows"]]]
        set command [lindex [lindex $::RunnerMock::calls 0] 0]
        list $result [file tail [lindex $command 0]] \
            [lrange $command 1 end]
    } finally {
        if {$plugins ne ""} {
            $plugins destroy
        }
        $runner destroy
        set ::env(PATH) $previousPath
        file delete -force $root
    }
} -result [list "sandboxed Tcl output" rundll32.exe \
    [list url.dll,FileProtocolHandler "https://example.com/windows"]]

test open-browser-1.4 {omitting URL opens a neutral blank page} -body {
    set root [file normalize [file join \
        [::tcltest::temporaryDirectory] open-browser-blank-[pid]]]
    file mkdir $root
    set fakeOpener [file join $root xdg-open]
    set channel [open $fakeOpener w]
    puts $channel {#!/bin/sh}
    close $channel
    file attributes $fakeOpener -permissions 0755
    set ::RunnerMock::calls {}
    set runner [::tProcessRunner new \
        $root tclsh9.0 2500 4096 ::RunnerMock::execute \
        [dict create xdg-open $fakeOpener]]
    set plugins [::tPluginRegistry new \
        $root [list [file join $projectDir plugins]] \
        ::ApprovalMock::decide 1000 65536 {} "" "" $runner \
        false {} linux]
    set ::ApprovalMock::approved 1
    try {
        set result [$plugins invoke open_browser [::json::write object]]
        set command [lindex [lindex $::RunnerMock::calls 0] 0]
        list $result [lrange $command 1 end]
    } finally {
        $plugins destroy
        $runner destroy
        file delete -force $root
    }
} -result [list "sandboxed Tcl output" [list about:blank]]

test open-browser-1.5 {tool metadata tells the model not to request a URL} -body {
    set registry [::tPluginRegistry new \
        $projectDir [list [file join $projectDir plugins]]]
    try {
        set definition {}
        foreach candidate [$registry definitions] {
            if {[dict get $candidate name] eq "open_browser"} {
                set definition $candidate
                break
            }
        }
        list \
            [dict get $definition parameters required] \
            [expr {[string first "do not ask for a URL" \
                [dict get $definition description]] >= 0}] \
            [expr {[string first "never ask the user" \
                [dict get $definition parameters properties url \
                    description]] >= 0}]
    } finally {
        $registry destroy
    }
} -result [list [list] 1 1]

::finishTests
