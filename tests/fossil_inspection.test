        $root [list [file join $projectDir plugins]] \
        "" 1000 65536 {} "" "" $runner]
    try {
        set result [$plugins invoke fossil_info \
            [::json::write object]]
        set call [lindex $::RunnerMock::calls 0]
        list \
            $result \
            [file tail [lindex [lindex $call 0] 0]] \
