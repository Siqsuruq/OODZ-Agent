#!/usr/bin/env tclsh

source [file join [file dirname [file normalize [info script]]] support.tcl]

test list-directory-1.1 {list_directory returns immediate files and directories} -body {
    set root [file normalize [file join \
        [temporaryDirectory] list-folders-[pid]-[clock clicks]]]
    file mkdir [file join $root alpha] [file join $root .hidden] \
        [file join $root nested child]
    set channel [open [file join $root visible.txt] w]
    close $channel
    set registry [tPluginRegistry new $root \
        [list [file join $projectDir plugins]]]
    try {
        set rootResult [$registry invoke list_directory \
            [::json::write object]]
        set nestedResult [$registry invoke list_directory \
            [::json::write object path \
                [::json::write string nested]]]
        set missingCode [catch {$registry invoke list_directory \
            [::json::write object path \
                [::json::write string missing]]} missingMessage]
        set escapeCode [catch {$registry invoke list_directory \
            [::json::write object path \
                [::json::write string ../outside]]} escapeMessage]
        list $rootResult $nestedResult \
            $missingCode $missingMessage $escapeCode $escapeMessage
    } finally {
        $registry destroy
        file delete -force $root
    }
} -result [list \
    ".hidden/\nalpha/\nnested/\nvisible.txt" "child/" \
    1 "Directory does not exist: missing" \
    1 "Plugin path escapes the workspace"]

test create-file-1.1 {create_file requires approval, writes content, and refuses overwrite} -body {
    set temporaryRoot [file join [temporaryDirectory] \
        "oodz-write-test-[pid]-[clock clicks]"]
    file mkdir $temporaryRoot
    set registry [::tPluginRegistry new \
        $temporaryRoot \
        [list [file join $projectDir plugins]] \
        [list ::ApprovalMock::decide]]
    set arguments [::json::write object \
        path [::json::write string "created.txt"] \
        content [::json::write string "hello café\n"]]

    try {
        set ::ApprovalMock::approved 0
        set deniedResult [catch {
            $registry invoke create_file $arguments
        } deniedMessage]
        set existsAfterDenial [file exists \
            [file join $temporaryRoot created.txt]]

        set ::ApprovalMock::approved 1
        set approvedResult [$registry invoke create_file $arguments]
        set repeatedCode [catch {
            $registry invoke create_file $arguments
        } repeatedMessage]
        set channel [open [file join $temporaryRoot created.txt] r]
        try {
            fconfigure $channel -encoding utf-8
            set writtenContent [read $channel]
        } finally {
            close $channel
        }

        list \
            $deniedResult $deniedMessage $existsAfterDenial \
            $approvedResult $writtenContent $repeatedCode $repeatedMessage
    } finally {
        $registry destroy
        file delete -force $temporaryRoot
    }
} -result [list \
    1 "Plugin execution denied: create_file" 0 \
    "Created file: created.txt" "hello café\n" \
    1 "File already exists: created.txt"]

test write-file-1.1 {write_file rewrites existing content and refuses creation} -body {
    set temporaryRoot [file join [temporaryDirectory] \
        "oodz-rewrite-test-[pid]-[clock clicks]"]
    file mkdir $temporaryRoot
    set target [file join $temporaryRoot existing.txt]
    set channel [open $target w]
    puts -nonewline $channel old
    close $channel
    set registry [::tPluginRegistry new $temporaryRoot \
        [list [file join $projectDir plugins]] [list ::ApprovalMock::decide]]
    set ::ApprovalMock::approved 1
    try {
        set rewritten [$registry invoke write_file [::json::write object \
            path [::json::write string existing.txt] \
            content [::json::write string "new content"]]]
        set channel [open $target r]
        set content [read $channel]
        close $channel
        set missingCode [catch {
            $registry invoke write_file [::json::write object \
                path [::json::write string new.txt] \
                content [::json::write string nope]]
        } missingMessage]
        list $rewritten $content $missingCode $missingMessage \
            [file exists [file join $temporaryRoot new.txt]]
    } finally {
        $registry destroy
        file delete -force $temporaryRoot
    }
} -result [list "Rewrote file: existing.txt" "new content" \
    1 "File does not exist: new.txt; use create_file for a new file" 0]

test create-directory-1.1 {create_directory is approved, recursive, and confined} -body {
    set temporaryRoot [file join [temporaryDirectory] \
        "oodz-mkdir-test-[pid]-[clock clicks]"]
    file mkdir $temporaryRoot
    set registry [::tPluginRegistry new \
        $temporaryRoot [list [file join $projectDir plugins]] \
        [list ::ApprovalMock::decide]]
    set nestedArguments [::json::write object \
        path [::json::write string "nested/deep"]]
    set escapeArguments [::json::write object \
        path [::json::write string "../outside"]]
    set occupiedPath [file join $temporaryRoot occupied]
    set occupiedChannel [open $occupiedPath w]
    close $occupiedChannel
    set occupiedArguments [::json::write object \
        path [::json::write string occupied]]

    try {
        set ::ApprovalMock::approved 0
        set deniedCode [catch {
            $registry invoke create_directory $nestedArguments
        } deniedMessage]
        set existsAfterDenial [file exists \
            [file join $temporaryRoot nested]]

        set ::ApprovalMock::approved 1
        set created [$registry invoke create_directory $nestedArguments]
        set nestedExists [file isdirectory \
            [file join $temporaryRoot nested deep]]
        set repeated [$registry invoke create_directory $nestedArguments]
        set escapeCode [catch {
            $registry invoke create_directory $escapeArguments
        } escapeMessage]
        set occupiedCode [catch {
            $registry invoke create_directory $occupiedArguments
        } occupiedMessage]

        list \
            $deniedCode $deniedMessage $existsAfterDenial \
            $created $nestedExists $repeated \
            $escapeCode $escapeMessage \
            $occupiedCode $occupiedMessage
    } finally {
        $registry destroy
        file delete -force $temporaryRoot
    }
} -result [list \
    1 "Plugin execution denied: create_directory" 0 \
    "Created directory: nested/deep" 1 \
    "Directory already exists: nested/deep" \
    1 "Plugin path escapes the workspace" \
    1 "Target exists and is not a directory: occupied"]

test replace-text-1.1 {replace_text performs one approved exact replacement} -body {
    set temporaryRoot [file join [temporaryDirectory] \
        "oodz-edit-test-[pid]-[clock clicks]"]
    file mkdir $temporaryRoot
    set target [file join $temporaryRoot sample.txt]
    set channel [open $target w]
    fconfigure $channel -encoding utf-8
    puts -nonewline $channel "alpha\ncafé\nomega\n"
    close $channel
    set registry [::tPluginRegistry new \
        $temporaryRoot [list [file join $projectDir plugins]] \
        [list ::ApprovalMock::decide]]
    set exactArguments [::json::write object \
        path [::json::write string sample.txt] \
        old_text [::json::write string "café"] \
        new_text [::json::write string "edited"]]

    try {
        set ::ApprovalMock::approved 0
        set deniedCode [catch {
            $registry invoke replace_text $exactArguments
        } deniedMessage]

        set ::ApprovalMock::approved 1
        set edited [$registry invoke replace_text $exactArguments]
        set channel [open $target r]
        fconfigure $channel -encoding utf-8
        set content [read $channel]
        close $channel

        set missingCode [catch {
            $registry invoke replace_text [::json::write object \
                path [::json::write string sample.txt] \
                old_text [::json::write string absent] \
                new_text [::json::write string replacement]]
        } missingMessage]

        set channel [open $target w]
        puts -nonewline $channel "same same"
        close $channel
        set ambiguousCode [catch {
            $registry invoke replace_text [::json::write object \
                path [::json::write string sample.txt] \
                old_text [::json::write string same] \
                new_text [::json::write string changed]]
        } ambiguousMessage]

        list \
            $deniedCode $deniedMessage \
            $edited $content \
            $missingCode $missingMessage \
            $ambiguousCode $ambiguousMessage
    } finally {
        $registry destroy
        file delete -force $temporaryRoot
    }
} -result [list \
    1 "Plugin execution denied: replace_text" \
    "Replaced text in: sample.txt" "alpha\nedited\nomega\n" \
    1 "old_text was not found in: sample.txt" \
    1 "old_text appears more than once in: sample.txt"]

test filesystem-mutations-1.1 {copy, move, and delete files safely} -body {
    set temporaryRoot [file join [temporaryDirectory] \
        "oodz-mutations-test-[pid]-[clock clicks]"]
    file mkdir [file join $temporaryRoot nested]
    set source [file join $temporaryRoot source.txt]
    set channel [open $source w]
    puts -nonewline $channel "original"
    close $channel
    set registry [::tPluginRegistry new \
        $temporaryRoot [list [file join $projectDir plugins]] \
        [list ::ApprovalMock::decide]]
    set copyArguments [::json::write object \
        source [::json::write string source.txt] \
        destination [::json::write string nested/copied.txt]]
    set moveArguments [::json::write object \
        source [::json::write string nested/copied.txt] \
        destination [::json::write string moved.txt]]
    set deleteArguments [::json::write object \
        path [::json::write string moved.txt]]

    try {
        set ::ApprovalMock::approved 0
        set deniedCode [catch {
            $registry invoke copy_file $copyArguments
        } deniedMessage]
        set ::ApprovalMock::approved 1
        set copied [$registry invoke copy_file $copyArguments]
        set overwriteCode [catch {
            $registry invoke copy_file $copyArguments
        } overwriteMessage]
        set moved [$registry invoke move_file $moveArguments]
        set deleted [$registry invoke delete_file $deleteArguments]
        set directoryCode [catch {
            $registry invoke delete_file [::json::write object \
                path [::json::write string nested]]
        } directoryMessage]

        list $deniedCode $deniedMessage \
            $copied $overwriteCode $overwriteMessage \
            $moved [file exists [file join $temporaryRoot nested copied.txt]] \
            $deleted [file exists [file join $temporaryRoot moved.txt]] \
            $directoryCode $directoryMessage
    } finally {
        $registry destroy
        file delete -force $temporaryRoot
    }
} -result [list \
    1 "Plugin execution denied: copy_file" \
    "Copied file: source.txt -> nested/copied.txt" \
    1 "Destination already exists: nested/copied.txt" \
    "Moved file: nested/copied.txt -> moved.txt" 0 \
    "Deleted file: moved.txt" 0 \
    1 "Path is not a file: nested"]

test delete-directory-1.1 {directory deletion is conservative and workspace confined} -body {
    set temporaryRoot [file join [temporaryDirectory] \
        "oodz-delete-directory-test-[pid]-[clock clicks]"]
    file mkdir [file join $temporaryRoot empty]
    file mkdir [file join $temporaryRoot populated child]
    set channel [open [file join $temporaryRoot populated child data.txt] w]
    puts -nonewline $channel data
    close $channel
    set channel [open [file join $temporaryRoot regular.txt] w]
    close $channel
    set registry [::tPluginRegistry new \
        $temporaryRoot [list [file join $projectDir plugins]] \
        [list ::ApprovalMock::decide]]

    try {
        set ::ApprovalMock::approved 0
        set deniedCode [catch {
            $registry invoke delete_directory [::json::write object \
                path [::json::write string empty]]
        } deniedMessage]
        set ::ApprovalMock::approved 1
        set deleted [$registry invoke delete_directory [::json::write object \
            path [::json::write string empty]]]
        set nonemptyCode [catch {
            $registry invoke delete_directory [::json::write object \
                path [::json::write string populated]]
        } nonemptyMessage]
        set recursiveResult [$registry invoke delete_directory \
            [::json::write object \
                path [::json::write string populated] \
                recursive true]]
        set rootCode [catch {
            $registry invoke delete_directory [::json::write object \
                path [::json::write string .]]
        } rootMessage]
        set fileCode [catch {
            $registry invoke delete_directory [::json::write object \
                path [::json::write string regular.txt]]
        } fileMessage]
        set escapeCode [catch {
            $registry invoke delete_directory [::json::write object \
                path [::json::write string ../outside]]
        } escapeMessage]

        list $deniedCode $deniedMessage \
            $deleted [file exists [file join $temporaryRoot empty]] \
            $nonemptyCode $nonemptyMessage \
            $recursiveResult [file exists [file join $temporaryRoot populated]] \
            $rootCode $rootMessage $fileCode $fileMessage \
            $escapeCode $escapeMessage
    } finally {
        $registry destroy
        file delete -force $temporaryRoot
    }
} -result [list \
    1 "Plugin execution denied: delete_directory" \
    "Deleted directory: empty" 0 \
    1 "Directory is not empty: populated; use recursive=true to delete its contents" \
    "Deleted directory recursively: populated" 0 \
    1 "The workspace root cannot be deleted" \
    1 "Path is not a directory: regular.txt" \
    1 "Plugin path escapes the workspace"]

test move-directory-1.1 {directories can be renamed and moved without unsafe targets} -body {
    set temporaryRoot [file join [temporaryDirectory] \
        "oodz-move-directory-test-[pid]-[clock clicks]"]
    file mkdir [file join $temporaryRoot source child]
    file mkdir [file join $temporaryRoot archive]
    file mkdir [file join $temporaryRoot occupied]
    set channel [open [file join $temporaryRoot source child data.txt] w]
    puts -nonewline $channel data
    close $channel
    set channel [open [file join $temporaryRoot regular.txt] w]
    close $channel
    set registry [::tPluginRegistry new \
        $temporaryRoot [list [file join $projectDir plugins]] \
        [list ::ApprovalMock::decide]]

    try {
        set arguments [::json::write object \
            source [::json::write string source] \
            destination [::json::write string renamed]]
        set ::ApprovalMock::approved 0
        set deniedCode [catch {
            $registry invoke move_directory $arguments
        } deniedMessage]
        set ::ApprovalMock::approved 1
        set renamed [$registry invoke move_directory $arguments]
        set moved [$registry invoke move_directory [::json::write object \
            source [::json::write string renamed] \
            destination [::json::write string archive/moved]]]
        set contentExists [file isfile \
            [file join $temporaryRoot archive moved child data.txt]]
        set occupiedCode [catch {
            $registry invoke move_directory [::json::write object \
                source [::json::write string archive/moved] \
                destination [::json::write string occupied]]
        } occupiedMessage]
        set nestedCode [catch {
            $registry invoke move_directory [::json::write object \
                source [::json::write string archive/moved] \
                destination [::json::write string archive/moved/child/new]]
        } nestedMessage]
        set rootCode [catch {
            $registry invoke move_directory [::json::write object \
                source [::json::write string .] \
                destination [::json::write string elsewhere]]
        } rootMessage]
        set fileCode [catch {
            $registry invoke move_directory [::json::write object \
                source [::json::write string regular.txt] \
                destination [::json::write string renamed-file]]
        } fileMessage]
        set parentCode [catch {
            $registry invoke move_directory [::json::write object \
                source [::json::write string archive/moved] \
                destination [::json::write string missing/moved]]
        } parentMessage]

        list $deniedCode $deniedMessage $renamed $moved $contentExists \
            $occupiedCode $occupiedMessage $nestedCode $nestedMessage \
            $rootCode $rootMessage $fileCode $fileMessage \
            $parentCode $parentMessage
    } finally {
        $registry destroy
        file delete -force $temporaryRoot
    }
} -result [list \
    1 "Plugin execution denied: move_directory" \
    "Moved directory: source -> renamed" \
    "Moved directory: renamed -> archive/moved" 1 \
    1 "Destination already exists: occupied" \
    1 "A directory cannot be moved inside itself: archive/moved/child/new" \
    1 "The workspace root cannot be moved" \
    1 "Source path is not a directory: regular.txt" \
    1 "Destination parent directory does not exist: missing"]

test apply-patch-1.1 {apply_patch makes multiple exact changes atomically} -body {
    set temporaryRoot [file join [temporaryDirectory] \
        "oodz-patch-test-[pid]-[clock clicks]"]
    file mkdir $temporaryRoot
    set target [file join $temporaryRoot sample.txt]
    set channel [open $target w]
    puts -nonewline $channel "alpha\nbeta\ngamma\n"
    close $channel
    set registry [::tPluginRegistry new \
        $temporaryRoot [list [file join $projectDir plugins]] \
        [list ::ApprovalMock::decide]]
    set patchText "<<<<<<< SEARCH\nalpha\n=======\nfirst\n>>>>>>> REPLACE\n<<<<<<< SEARCH\ngamma\n=======\nthird\n>>>>>>> REPLACE"
    set arguments [::json::write object \
        path [::json::write string sample.txt] \
        patch [::json::write string $patchText]]

    try {
        set ::ApprovalMock::approved 1
        set result [$registry invoke apply_patch $arguments]
        set channel [open $target r]
        set content [read $channel]
        close $channel
        set badPatch "<<<<<<< SEARCH\nmissing\n=======\nchanged\n>>>>>>> REPLACE"
        set failedCode [catch {
            $registry invoke apply_patch [::json::write object \
                path [::json::write string sample.txt] \
                patch [::json::write string $badPatch]]
        } failedMessage]
        set channel [open $target r]
        set contentAfterFailure [read $channel]
        close $channel
        list $result $content $failedCode $failedMessage $contentAfterFailure
    } finally {
        $registry destroy
        file delete -force $temporaryRoot
    }
} -result [list \
    "Applied patch to: sample.txt (2 change(s))" \
    "first\nbeta\nthird\n" \
    1 "Patch SEARCH text was not found in: sample.txt" \
    "first\nbeta\nthird\n"]

test write-file-1.2 {CLI approval accepts yes and defaults to denial} -body {
    set inputChannel [file tempfile inputPath]
    set outputChannel [file tempfile outputPath]
    try {
        puts $inputChannel "yes"
        puts $inputChannel "no"
        flush $inputChannel
        seek $inputChannel 0

        set arguments [dict create path "created.txt"]
        set yesResult [::requestPluginApproval \
            $inputChannel $outputChannel write_file $arguments]
        set noResult [::requestPluginApproval \
            $inputChannel $outputChannel write_file $arguments]
        flush $outputChannel
        seek $outputChannel 0

        list \
            $yesResult $noResult \
            [regexp -all {Allow write plugin 'write_file'} \
                [read $outputChannel]]
    } finally {
        close $inputChannel
        close $outputChannel
        file delete $inputPath $outputPath
    }
} -result [list 1 0 2]

test write-file-1.3 {CLI approval temporarily uses blocking input} -body {
    set inputChannel [file tempfile inputPath]
    set outputChannel [file tempfile outputPath]
    try {
        puts $inputChannel "y"
        flush $inputChannel
        seek $inputChannel 0
        fconfigure $inputChannel -blocking 0
        set approved [::requestPluginApproval \
            $inputChannel $outputChannel write_file \
            [dict create path sample.txt]]
        list $approved [fconfigure $inputChannel -blocking]
    } finally {
        close $inputChannel
        close $outputChannel
        file delete $inputPath $outputPath
    }
} -result [list 1 0]

test write-file-1.4 {all approves remaining writes for this session} -body {
    set inputChannel [file tempfile inputPath]
    set outputChannel [file tempfile outputPath]
    try {
        set ::approveAllWritesForSession 0
        puts $inputChannel "all"
        flush $inputChannel
        seek $inputChannel 0

        set arguments [dict create path "created.txt"]
        set firstResult [::requestPluginApproval \
            $inputChannel $outputChannel write_file $arguments]
        set secondResult [::requestPluginApproval \
            $inputChannel $outputChannel delete_file $arguments]
        flush $outputChannel
        seek $outputChannel 0

        list \
            $firstResult $secondResult \
            [regexp -all {Allow write plugin} [read $outputChannel]]
    } finally {
        set ::approveAllWritesForSession 0
        close $inputChannel
        close $outputChannel
        file delete $inputPath $outputPath
    }
} -result [list 1 1 1]

test write-file-1.5 {approve all never bypasses Tcl execution approval} -body {
    set inputChannel [file tempfile inputPath]
    set outputChannel [file tempfile outputPath]
    try {
        set ::approveAllWritesForSession 0
        puts $inputChannel "all"
        puts $inputChannel "y"
        puts $inputChannel "y"
        puts $inputChannel "y"
        flush $inputChannel
        seek $inputChannel 0
        set arguments [dict create path script.tcl]
        set writeResult [::requestPluginApproval \
            $inputChannel $outputChannel write_file $arguments]
        set runnerResult [::requestPluginApproval \
            $inputChannel $outputChannel run_tcl_file $arguments]
        set projectResult [::requestPluginApproval \
            $inputChannel $outputChannel run_project_tests [dict create]]
        set commandResult [::requestPluginApproval \
            $inputChannel $outputChannel exec_command [dict create \
                resolved_executable /usr/bin/example \
                arguments [list --version] \
                resolved_working_directory /workspace \
                timeout_ms 1000]]
        flush $outputChannel
        seek $outputChannel 0
        set prompts [read $outputChannel]
        list \
            $writeResult $runnerResult $projectResult $commandResult \
            [expr {[string first "No OS sandbox may be active" \
                $prompts] >= 0}] \
            [expr {[string first "/usr/bin/example" $prompts] >= 0}]
    } finally {
        set ::approveAllWritesForSession 0
        close $inputChannel
        close $outputChannel
        file delete $inputPath $outputPath
    }
} -result [list 1 1 1 1 1 1]


::finishTests
